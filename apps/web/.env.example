NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional dev escape hatch: when true (and Clerk keys are absent), the
# dashboard runs without auth and the API client sends x-dev-user-id.
NEXT_PUBLIC_DEV_AUTH_BYPASS=true
NEXT_PUBLIC_DEV_USER_ID=user_fm_alpha
