# --- App ---
NODE_ENV=development
PORT=3001
WEB_APP_URL=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=mysql://onvest:onvest_pw@localhost:3306/onvest

# --- Clerk ---
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Dev-only escape hatch: when "true" and CLERK_SECRET_KEY is empty, the
# JWT guard accepts requests carrying header x-dev-user-id without
# signature verification. NEVER enable in production.
DEV_AUTH_BYPASS=false

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=onvest-documents

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Onvest <noreply@on-vest.com>
